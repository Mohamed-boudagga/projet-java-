<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color:#1a1a2e;">

    <!-- ===== BARRE LATERALE ===== -->
    <left>
        <VBox spacing="5" prefWidth="220"
              style="-fx-background-color:#16213e; -fx-padding:20;">

            <Label text="SkillQuest"
                   style="-fx-font-size:24px; -fx-font-weight:bold;
                          -fx-text-fill:#f45b69; -fx-padding:0 0 20 0;"/>
            <Label text="PANNEAU ADMIN"
                   style="-fx-font-size:11px; -fx-text-fill:#a8a8b3; -fx-padding:0 0 20 10;"/>

            <Button fx:id="btnEtudiants" text="👥  Étudiants"
                    onAction="#afficherEtudiants"
                    maxWidth="Infinity"
                    style="-fx-background-color:#f45b69; -fx-text-fill:white;
                           -fx-font-size:14px; -fx-background-radius:6; -fx-padding:12;
                           -fx-cursor:hand; -fx-alignment:CENTER-LEFT;"/>

            <Button fx:id="btnExamens" text="📝  Examens &amp; Certifs"
                    onAction="#handleGoToExams"
                    maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#a8a8b3;
                           -fx-font-size:14px; -fx-background-radius:6; -fx-padding:12;
                           -fx-cursor:hand; -fx-alignment:CENTER-LEFT;"/>

            <Button fx:id="btnJeux" text="🎮  Jeux SkillQuest"
                    onAction="#handleGoToGames"
                    maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#a8a8b3;
                           -fx-font-size:14px; -fx-background-radius:6; -fx-padding:12;
                           -fx-cursor:hand; -fx-alignment:CENTER-LEFT;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪  Déconnexion"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#f45b69;
                           -fx-font-size:13px; -fx-border-color:#f45b69;
                           -fx-border-radius:6; -fx-background-radius:6;
                           -fx-padding:10; -fx-cursor:hand;"/>
        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding:25;">
            <children>
                <!-- Vue par défaut (Étudiants) -->
                <VBox fx:id="viewEtudiants" spacing="15">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Gestion des Étudiants"
                               style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ajouter Étudiant"
                                onAction="#handleAjouterEtudiant"
                                style="-fx-background-color:#f45b69; -fx-text-fill:white;
                                       -fx-font-size:13px; -fx-background-radius:6;
                                       -fx-padding:10 20; -fx-cursor:hand;"/>
                    </HBox>

                    <TableView fx:id="tableEtudiants" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
                            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="100"/>
                            <TableColumn fx:id="colPoints" text="Points" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>
